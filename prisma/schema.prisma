// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HeroSlide {
  id          Int      @id @default(autoincrement())
  title       String
  subtitle    String
  description String
  image       String
  gradient    String
  order       Int      @default(0)
  language    String   @default("ar") // "ar" for Arabic, "en" for English
}

model University {
  id             Int    @id @default(autoincrement())
  name           String
  country        String
  logo           String
  ranking        String
  students       String
  programs       String
  acceptance     String
  color          String
  flag           String
  order          Int    @default(0)
  freeOfferLetter Boolean @default(false)
  emailAddress   String? // University contact email for applications
  departments    Department[]
  sentEmails     SentEmail[]
}

model Department {
  id         Int      @id @default(autoincrement())
  name       String
  university University @relation(fields: [universityId], references: [id])
  universityId Int
  programs   Program[]
}

model Program {
  id                Int      @id @default(autoincrement())
  name              String
  description       String
  tuitionFees       String
  duration          String
  intakeMonths      String
  qualification     String   @default("Bachelor's Degree")
  englishRequirement String   @default("IELTS 5.5")
  offerLetter       Boolean  @default(true)
  classType         String   @default("Physical")
  // Detailed fee structure for international students
  yearlyTuitionFees String   @default("") // JSON string for yearly fees
  otherFees         String   @default("") // JSON string for other fees
  department        Department @relation(fields: [departmentId], references: [id])
  departmentId      Int
}

model Testimonial {
  id         Int    @id @default(autoincrement())
  name       String
  program    String
  text       String
  rating     Int
  avatar     String
  university String
  country    String
  flag       String
  date       String
  hasVideo   Boolean
  featured   Boolean
  category   String
  order      Int    @default(0)
  language   String @default("ar") // "ar" for Arabic, "en" for English
}

model Faq {
  id       Int    @id @default(autoincrement())
  question String
  answer   String
  category String
  popular  Boolean
  order    Int    @default(0)
  language String @default("ar") // "ar" for Arabic, "en" for English
}

model WhySMAlkaff {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  features    String   // JSON string for features array
  language    String   @default("ar") // "ar" for Arabic, "en" for English
}

model HowItWorks {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  steps       String   // JSON string for steps array
  language    String   @default("ar") // "ar" for Arabic, "en" for English
}

model HomePageUniversity {
  id             Int    @id @default(autoincrement())
  name           String
  country        String
  logo           String
  ranking        String
  students       String
  programs       String
  acceptance     String
  color          String
  flag           String
  order          Int    @default(0)
  freeOfferLetter Boolean @default(false)
  language       String @default("ar") // "ar" for Arabic, "en" for English
}

model FormSubmission {
  id                Int           @id @default(autoincrement())
  fullName          String
  nationality       String
  email             String
  countryOfResidence String
  contactNumber     String
  cityOfResidence   String
  preferredProgram  String
  universityId      Int?
  programId         Int?
  submittedAt       DateTime      @default(now())
  uploadedFiles     UploadedFile[]
  agentId           Int?          // For agent assignment
  agent             Agent?        @relation(fields: [agentId], references: [id])
  orderStage        String        @default("New") // For order stage management
  submissionStatus  String        @default("submitted") // submitted, approved_by_admin, sent_to_university, accepted_by_university, rejected_by_university, submitted_visa_info, submitted_payment, completed
  userId            Int?          @unique // For user account linking (one-to-one)
  user              User?         @relation(fields: [userId], references: [id])
  orders            Order[]
  sentEmails        SentEmail[]   // Track emails sent for this submission
  // Payment receipt fields
  paymentReceiptPath String?      // Path to uploaded payment receipt
  canUploadReceipt  Boolean       @default(false) // Whether student can upload receipt
  receiptUploadedAt DateTime?     // When receipt was uploaded
  receiptViewedByAdmin Boolean    @default(false) // Whether admin has viewed the receipt
  // Visa document fields
  visaDocumentsPath String?       // Path to uploaded visa documents
  canUploadVisaDocuments Boolean  @default(false) // Whether student can upload visa documents
  visaDocumentsUploadedAt DateTime? // When visa documents were uploaded
  visaDocumentsViewedByAdmin Boolean @default(false) // Whether admin has viewed the visa documents
}

model Agent {
  id         Int            @id @default(autoincrement())
  name       String
  email      String         @unique
  phone      String?
  password   String?        // Hashed password for agent login
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  submissions FormSubmission[]
  orders     Order[]
  commissions Commission[]
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  password      String         // Hashed password
  email         String         @unique
  fullName      String
  formSubmissionId Int?        @unique // Link to form submission (one-to-one)
  formSubmission FormSubmission?
  orders        Order[]
  role          String         @default("student") // "student", "agent", or "admin"
  sentNotes     SentNote[]     // Notes sent by this user (for admins)
  createdTickets SupportTicket[] @relation("TicketCreator") // Tickets created by this user
  assignedTickets SupportTicket[] @relation("TicketAssignee") // Tickets assigned to this user (for agents/admins)
  sentMessages  SupportTicketMessage[] @relation("MessageSender") // Messages sent by this user
  notifications Notification[]  // Notifications for this user
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model UploadedFile {
  id              Int      @id @default(autoincrement())
  filename        String
  originalName    String
  path            String
  size            Int
  type            String
  formSubmission  FormSubmission @relation(fields: [formSubmissionId], references: [id])
  formSubmissionId Int
  uploadedAt      DateTime @default(now())
}

model Order {
  id              Int        @id @default(autoincrement())
  userId          Int
  user            User       @relation(fields: [userId], references: [id])
  formSubmissionId Int?
  formSubmission   FormSubmission? @relation(fields: [formSubmissionId], references: [id])
  agentId         Int?
  agent           Agent?     @relation(fields: [agentId], references: [id])
  // Remove price and paymentStatus as they're not needed
  agentStatus     String     @default("Created by Agent")   // Created by Agent, In Progress, Submitted, Under Review (editable by agent)
  adminStatus     String     @default("Pending")  // Pending, Approved, Rejected, Sent to University, Accepted by University (editable by admin)
  paymentStatus   String     @default("unpaid")  // paid, unpaid (whether student has paid)
  // New submission status field for student progress tracking
  submissionStatus String    @default("submitted") // submitted, approved_by_admin, sent_to_university, accepted_by_university, rejected_by_university, submitted_visa_info, submitted_payment, completed
  invoice         String?    // URL or path to uploaded invoice file
  dateCreated     DateTime   @default(now())
  agentNotes      String?    // Private notes from agent to admin
  adminNotes      String?    // Private notes from admin to agent
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  commissions     Commission[]
}

model Commission {
  id              Int        @id @default(autoincrement())
  agentId         Int
  agent           Agent      @relation(fields: [agentId], references: [id])
  orderId         Int
  order           Order      @relation(fields: [orderId], references: [id])
  amount          Float      // Commission amount
  status          String     @default("pending") // pending, approved, paid, rejected
  requestedAt     DateTime   @default(now())
  approvedAt      DateTime?  // When admin approves
  paidAt          DateTime?  // When commission is paid
  notes           String?    // Admin notes
  // Receipt and delivery tracking fields
  receiptPath     String?    // Path to uploaded receipt file
  receiptUploadedAt DateTime? // When receipt was uploaded
  receiptViewedByAgent Boolean @default(false) // Whether agent has viewed the receipt
  deliveredToAgent Boolean   @default(false) // Whether physical commission was delivered
  deliveredAt     DateTime?  // When commission was physically delivered
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model EmailTemplate {
  id              Int        @id @default(autoincrement())
  name            String     @unique
  subject         String
  body            String     // Email body with placeholders like {{fullName}}, {{email}}, etc.
  templateType    String     @default("standard") // "standard", "optional_info"
  description     String?    // Description of when to use this template
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  sentEmails      SentEmail[]
}

model SentEmail {
  id              Int        @id @default(autoincrement())
  fromEmail       String     // Admin/system email
  toEmail         String     // University email
  subject         String
  body            String     // Final rendered email body
  templateId      Int?       // Reference to template used
  template        EmailTemplate? @relation(fields: [templateId], references: [id])
  formSubmissionId Int       // Reference to the form submission
  formSubmission  FormSubmission @relation(fields: [formSubmissionId], references: [id])
  universityId    Int?       // Reference to university
  university      University? @relation(fields: [universityId], references: [id])
  attachmentPaths String?    // JSON array of file paths attached
  status          String     @default("sent") // sent, delivered, failed, replied
  sentAt          DateTime   @default(now())
  deliveredAt     DateTime?
  replyReceived   Boolean    @default(false)
  replyContent    String?    // Content of university reply
  replyReceivedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model SmtpSettings {
  id              Int        @id @default(autoincrement())
  host            String     // SMTP server host
  port            Int        // SMTP server port
  username        String     // SMTP username
  password        String     // SMTP password (encrypted)
  encryption      String     @default("tls") // "ssl", "tls", "none"
  fromEmail       String     // Default from email address
  fromName        String     @default("SM Alkaff") // Default from name
  isEnabled       Boolean    @default(true) // Whether SMTP is enabled
  isDefault       Boolean    @default(false) // Whether this is the default configuration
  testEmail       String?    // Email address for testing
  lastTested      DateTime?  // Last time settings were tested
  testStatus      String?    // "success", "failed", "pending"
  testError       String?    // Last test error message
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model NoteTemplate {
  id              Int        @id @default(autoincrement())
  title           String
  content         String     // Note content with placeholders like {{fullName}}, {{email}}, etc.
  category        String     @default("general") // "general", "application", "payment", "urgent"
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  sentNotes       SentNote[]
}

model SentNote {
  id              Int        @id @default(autoincrement())
  templateId      Int?       // Reference to template used (nullable for manual notes)
  template        NoteTemplate? @relation(fields: [templateId], references: [id])
  content         String     // Final rendered note content
  senderId        Int        // Admin who sent the note
  sender          User       @relation(fields: [senderId], references: [id])
  recipientType   String     // "individual", "agents", "students", "all"
  recipientIds    String     // JSON array of user IDs who should receive this note
  readStatus      String     @default("{}") // JSON object tracking read status {userId: timestamp}
  priority        String     @default("normal") // "low", "normal", "high", "urgent"
  expiresAt       DateTime?  // Optional expiration date
  sentAt          DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model SupportTicket {
  id              Int        @id @default(autoincrement())
  title           String
  description     String
  status          String     @default("open") // "open", "in_progress", "resolved", "closed"
  priority        String     @default("medium") // "low", "medium", "high", "urgent"
  category        String     @default("general") // "technical", "billing", "account", "general"
  createdById     Int        // User who created the ticket
  createdBy       User       @relation("TicketCreator", fields: [createdById], references: [id])
  assignedToId    Int?       // Agent assigned to the ticket (nullable)
  assignedTo      User?      @relation("TicketAssignee", fields: [assignedToId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  messages        SupportTicketMessage[]
}

model SupportTicketMessage {
  id              Int        @id @default(autoincrement())
  ticketId        Int
  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId        Int        // User who sent the message
  sender          User       @relation("MessageSender", fields: [senderId], references: [id])
  message         String
  isInternal      Boolean    @default(false) // Internal notes only visible to admin/agents
  attachments     String?    // JSON array of file paths (optional)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Notification {
  id              Int        @id @default(autoincrement())
  title           String
  message         String
  type            String     @default("info") // info, warning, success, error
  priority        String     @default("normal") // low, normal, high, urgent
  isRead          Boolean    @default(false)
  entityId        Int?       // ID of related entity (form submission, order, etc.)
  entityType      String?    // Type of related entity (FormSubmission, Order, etc.)
  userId          Int?       // User this notification is for (null for admin notifications)
  user            User?      @relation(fields: [userId], references: [id])
  createdAt       DateTime   @default(now())
  readAt          DateTime?
  actionUrl       String?    // URL to navigate to when clicking notification
  metadata        String?    // JSON string for additional data
}

model WhatsAppSettings {
  id              Int        @id @default(autoincrement())
  phoneNumber     String     // WhatsApp phone number with country code (e.g., +966501234567)
  displayText     String     @default("تواصل معنا عبر واتساب") // Text to display on hover
  isEnabled       Boolean    @default(true) // Whether the WhatsApp button is enabled
  position        String     @default("bottom-right") // Position of the floating button
  welcomeMessage  String     @default("مرحباً! كيف يمكنني مساعدتك؟") // Pre-filled message when opening WhatsApp
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

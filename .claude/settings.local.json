{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/opt/python@3.13/bin/python3.13 /opt/homebrew/lib/python3.13/site-packages/realign/claude_hooks/stop_hook.py  # aline-stop-hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/opt/python@3.13/bin/python3.13 /opt/homebrew/lib/python3.13/site-packages/realign/claude_hooks/user_prompt_submit_hook.py  # aline-user-prompt-submit-hook"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/opt/python@3.13/bin/python3.13 /opt/homebrew/lib/python3.13/site-packages/realign/claude_hooks/permission_request_hook.py  # aline-permission-request-hook"
          }
        ]
      }
    ]
  }
}